{
  "expo": {
    "name": "GEO-EXPO Alert",
    "slug": "geo-expo-alert",
    "scheme": "geoexpo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.geoexpo.alert",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Tu ubicación se envía a tus contactos de emergencia cuando se confirma una alerta.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "package": "com.geoexpo.alert",
      "adaptiveIcon": {
        "backgroundColor": "#2E6BFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F2F3F7",
          "dark": {
            "backgroundColor": "#07080C"
          }
        }
      ],
      "expo-font",
      "expo-image",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "La app se conecta por Bluetooth a tu llavero GEO-EXPO para recibir sus alertas, también en segundo plano."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tu ubicación se envía a tus contactos de emergencia cuando se confirma una alerta.",
          "motionUsagePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF3B30"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
